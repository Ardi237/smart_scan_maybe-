@page
@model SmartScanner.Web.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "General Settings";
}

<section class="page-heading">
    <p class="eyebrow">GENERAL SETTINGS</p>
    <h1>Klasifikasi kode asisten</h1>
    <p>Kode asisten pada submission ditentukan otomatis dari nomor absen.</p>
</section>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <p class="notice notice--success">@Model.SuccessMessage</p>
}

<form method="post" class="settings-form">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Dari absen</th><th>Sampai absen</th><th>Kode asisten</th><th>Aktif</th></tr></thead>
            <tbody>
            @for (var index = 0; index < Model.Rules.Count; index++)
            {
                <tr>
                    <td><input asp-for="Rules[index].MinimumAttendanceNumber" type="number" min="1" /><input asp-for="Rules[index].Id" type="hidden" /></td>
                    <td><input asp-for="Rules[index].MaximumAttendanceNumber" type="number" min="1" /></td>
                    <td><input asp-for="Rules[index].AssistantCode" /></td>
                    <td><input asp-for="Rules[index].IsActive" /></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <button class="button button--primary" type="submit">Simpan pengaturan</button>
</form>
